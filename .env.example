# Пароль для /admin — не короче 12 символов, лучше случайный
ADMIN_PASSWORD=придумайте-надёжный-пароль

# Telegram-бот (создайте у @BotFather): подтверждение номеров участников и коды входа в админку
# TELEGRAM_BOT_TOKEN=123456:ABC...
# ID админов через запятую — им бот присылает код входа. Узнать свой ID: напишите боту /id
# TELEGRAM_ADMIN_IDS=123456789
# Локально: бот сам забирает сообщения (вебхук на localhost не работает). Лучше отдельный тестовый бот.
# TELEGRAM_POLLING=1

# Postgres (Neon). На Vercel подставляется автоматически после подключения Neon.
# Локально можно не задавать — тогда база хранится в data/pglite.
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

PORT=3001
